# Google Cloud Vertex AI (recommended — uses Google Cloud billing/credits)
GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account","project_id":"your-gcp-project-id",...}
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Or Google Gemini Developer API Key fallback (server-side only — never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
# GEMINI_QUESTION_MODEL=gemini-3.8-flash
# GEMINI_FLASH_MODEL=gemini-3.8-flash

# Supabase (client-side — VITE_ prefix makes them available in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
